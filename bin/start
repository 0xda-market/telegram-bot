#!/usr/bin/env ruby
# frozen_string_literal: true

$stdout.sync = true

require_relative "../lib/zero_x_da/market/telegram_bot/telegram_api"
require_relative "../lib/zero_x_da/market/telegram_bot/bot"

register_webhook = ENV.fetch("REGISTER_TELEGRAM_WEBHOOK", "1") == "1"
register_web_app = ENV.fetch("REGISTER_TELEGRAM_WEBAPP", "0") == "1"

if register_webhook || register_web_app
  public_url = ENV.fetch("PUBLIC_URL").delete_suffix("/")
  telegram = ZeroXDA::Market::TelegramBot::TelegramAPI.new(
    token: ENV.fetch("TELEGRAM_BOT_TOKEN")
  )

  if register_webhook
    webhook_url = "#{public_url}/telegram/webhook"
    telegram.set_webhook(
      url: webhook_url,
      secret_token: ENV.fetch("TELEGRAM_WEBHOOK_SECRET")
    )
    telegram.set_commands(
      ZeroXDA::Market::TelegramBot::Bot::START_COMMANDS,
      scope: { type: "default" }
    )
    puts "Telegram webhook configured: #{webhook_url}"
  else
    puts "Telegram webhook registration skipped"
  end

  if register_web_app
    web_app_url = "#{public_url}/webapp/"
    telegram.set_chat_menu_web_app(text: "Market", url: web_app_url)
    puts "Telegram Mini App menu button configured: #{web_app_url}"
  else
    puts "Telegram Mini App menu button registration skipped"
  end
else
  puts "Telegram webhook registration skipped"
  puts "Telegram Mini App menu button registration skipped"
end

exec("bundle", "exec", "puma", "-C", "config/puma.rb", "config.ru")
