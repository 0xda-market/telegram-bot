DEPLOY_ENV=development
MARKET_CORE_ENV=development
MARKET_EDGE_NETWORK=nilx-edge
PORT=10000

TELEGRAM_BOT_TOKEN=replace-me
TELEGRAM_BOT_USERNAME=replace-me
TELEGRAM_WEBAPP_AUTH_MAX_AGE_SECONDS=3600
TELEGRAM_WEBHOOK_SECRET=replace-me

MARKET_API_URL=http://market-api-development:10000
MARKET_API_TOKEN=replace-me

# 0x1 Special for seeds. Set all four or none; without them Special stays a
# preview. NILX_PARTNER_TOKEN is Identity's PARTNER_LOOKUP_TOKEN, NILX_LINK_URL
# opens 0x1 where the person signs in and connects this Telegram account, and
# CHANNEL_ASSERTION_SECRET must equal Market Core's.
NILX_IDENTITY_URL=
NILX_PARTNER_TOKEN=
NILX_LINK_URL=
CHANNEL_ASSERTION_SECRET=

REGISTER_TELEGRAM_WEBHOOK=0
REGISTER_TELEGRAM_WEBAPP=0
PUBLIC_URL=https://0xda-market.nilx.one/bot-test
